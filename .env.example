# 会议知识库(业务系统) 可选配置 —— 复制为项目根目录 .env 后按需修改

# ---- 默认管理员(首次启动自动创建;登录后请立即修改密码) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 令牌有效期(分钟) ----
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- 令牌签名密钥(强烈建议生产环境设置;不设置则自动生成到 data/.secret_key) ----
# AUTH_SECRET_KEY=please-change-me-to-a-long-random-string

# ---- 文档生成走 DeepSeek 云端(可选;不配置则使用本地 Qwen 全本地生成) ----
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
